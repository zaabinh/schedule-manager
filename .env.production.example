POSTGRES_DB=schedule_manager
POSTGRES_USER=schedule_app
POSTGRES_PASSWORD=replace-with-32-plus-random-characters
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=5000
AUTH_RATE_LIMIT_PER_MINUTE=5
AUTH_RATE_LIMIT_PER_HOUR=30
PUBLIC_WEB_ORIGIN=https://app.schedule.example.edu.vn
PUBLIC_API_ORIGIN=https://api.schedule.example.edu.vn
SESSION_COOKIE_NAME=__Host-session
