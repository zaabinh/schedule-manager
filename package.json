{
  "name": "school-weekly-plan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/attachment-utils.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-e2e.ps1",
    "test:performance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-performance-smoke.ps1",
    "test:security": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-security-baseline.ps1",
    "release:validate-config": "node scripts/validate-production-config.mjs",
    "release:verify-staging": "node scripts/verify-staging.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.85.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2"
  }
}
