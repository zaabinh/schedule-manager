# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Backend/PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/schedule_manager
DB_USER=schedule_app
DB_PASSWORD=schedule_local_password
SCHOOL_TIME_ZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_PEPPER=replace-with-at-least-32-random-characters
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.edu.vn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
REMINDER_POLL_DELAY_MS=60000
REMINDER_MAX_ATTEMPTS=3
TASK_ATTACHMENT_MAX_FILES=10
TASK_ATTACHMENT_MAX_FILE_SIZE_BYTES=20971520
TASK_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=104857600
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_ROOT=./data/uploads

# One-time local/bootstrap operation. Disable immediately after the first successful start.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.vn
BOOTSTRAP_ADMIN_PASSWORD=Replace-With@StrongPassword
BOOTSTRAP_ADMIN_DISPLAY_NAME=Hiệu trưởng
BOOTSTRAP_ADMIN_DEPARTMENT_NAME=Văn phòng
